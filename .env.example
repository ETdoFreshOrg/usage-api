PORT=3000

# ET's 9router. Claude and Codex usage is read straight from Anthropic and
# OpenAI using the OAuth token 9router already holds and refreshes, so this
# service keeps no provider credentials of its own — see README.md.
#
# Path to 9router's connection store inside this container. On the Dokploy
# host, ~/.9router/db is bind-mounted read-only at /mnt/9router.
NINEROUTER_DB_PATH=/mnt/9router/data.sqlite

# Read-only OpenRouter management key for Jev-only 1/3/7-day spend totals.
OPENROUTER_MANAGEMENT_KEY=

# Optional: only needed when 9router has more than one connection per
# provider, or when the defaults below don't match your accounts. An account
# is named by whichever identifier 9router records: Codex connections carry
# an email, Claude ones may only have a display name such as "Account 1".
# NINEROUTER_CLAUDE_ACCOUNT=Account 1
# NINEROUTER_CLAUDE2_ACCOUNT=you+second@example.com
NINEROUTER_CODEX_ACCOUNT=etdofresh@gmail.com
NINEROUTER_CODEX2_ACCOUNT=etdofresh+dev@gmail.com

# Z.ai (Bearer token)
ZAI_API_KEY=

# OpenRouter (Bearer token)
OPENROUTER_API_KEY=

# OpenAI org admin key (for /v1/organization/costs)
OPENAI_ADMIN_KEY=

# Hard kill switch for the second Codex account, even when 9router has a
# matching NINEROUTER_CODEX2_ACCOUNT connection.
# CODEX2_ENABLED=false

# Hard kill switch for the second Claude account, even when
# NINEROUTER_CLAUDE2_ACCOUNT matches a registered 9router connection.
# CLAUDE2_ENABLED=false

# Polling tuning (seconds)
POLL_FLOOR_SECONDS=60
POLL_TARGET_SECONDS=150
POLL_CEILING_SECONDS=600

# Claude/Codex active checks (seconds); passive CPA headers fill in between
# ACCOUNT_IDLE_SECONDS=60
# ACCOUNT_IDLE_SECONDS_CLAUDE=60
# ACCOUNT_IDLE_SECONDS_CODEX=60
# ACCOUNT_BUSY_SECONDS=300
# ACCOUNT_PASSIVE_FRESH_SECONDS=120
# ACCOUNT_SPACING_SECONDS=5
# ACCOUNT_429_MAX_INTERVAL_SECONDS=900
# ACCOUNT_429_MAX_SECONDS=3600
# ACCOUNT_429_RELAX_SECONDS=1800
# ACCOUNT_STALE_LITTLE_SECONDS=180
# ACCOUNT_STALE_SECONDS=1800
# CODEX_RESET_CREDITS_SECONDS=10800

# Read-only MCP at /mcp (owner-key OAuth). Unset = MCP off, /mcp returns 503.
# USAGE_MCP_OWNER_KEY=        # also authorizes renewal-date edits (see below)
# USAGE_MCP_PUBLIC_ORIGIN=https://usage.etdofresh.com
# USAGE_MCP_OAUTH_DB=/home/node/data/mcp-oauth.db

# Manual subscription renewal dates. PUT/DELETE /api/renewals/:account need
# `Authorization: Bearer $USAGE_MCP_OWNER_KEY`. Defaults shown.
# USAGE_RENEWALS_FILE=/home/node/data/usage-renewals.json
# RENEWAL_TIME_ZONE=America/Chicago
